[Unit]
Description=Jetson host-side power monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/Desktop/SALUS/ROS2_SALUS
ExecStart=/home/admin/Desktop/SALUS/ROS2_SALUS/tools/run_jetson_power_monitor.sh --profile aggressive
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
