<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="slope_lidar">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-31.4858037</latitude_deg>
      <longitude_deg>-64.2410570</longitude_deg>
      <elevation>0.0</elevation>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>2000 2000 0.1</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="front_slope_10deg">
      <static>1</static>
      <!-- Lower edge starts around x=2 m; upper edge reaches about z=2.1 m.
           Keep the ramp wide so the LiDAR ROI does not see artificial side faces. -->
      <pose>8 0 1.04 0 -0.1745329252 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12 40 0.15</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12 40 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.45 0.35 1</ambient>
            <diffuse>0.42 0.56 0.42 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="slope_obstacle_left">
      <static>1</static>
      <pose>8.5 1.25 1.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.55 0.55 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.55 0.55 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.25 0.15 1</ambient>
            <diffuse>0.95 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="slope_obstacle_right">
      <static>1</static>
      <pose>10.2 -1.35 1.85 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.55 0.55 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.55 0.55 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.25 0.15 1</ambient>
            <diffuse>0.95 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <physics name="3ms" type="dart">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
