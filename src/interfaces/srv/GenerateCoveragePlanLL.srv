# Referencia geografica. Si start_is_field_corner=true es la esquina fisica
# inferior de la franja; el proveedor aplica el inset del implemento para
# obtener el centro de la primera pasada. Si es false, conserva la semantica
# directa de centro de pasada. Yaw ROS/map: 0=este, 90=norte.
float64 start_lat
float64 start_lon
float64 start_yaw_deg
bool start_is_field_corner

float64 field_length_m
float64 field_width_m

# --- Lote como poligono (modo preferente) ---
# Anillo exterior del campo. Vacio = modo legacy: el lote sale del rectangulo
# start_* + field_length_m + field_width_m + side, que se mantiene soportado.
# Cuando viene un poligono valido, tiene prioridad sobre el rectangulo.
interfaces/GeoRing coverage_polygon

# Zonas donde NO se debe cortar, como anillos interiores del campo.
#
# Esto es coverage_exclusion, NO keepout. El planificador no genera pasadas de
# trabajo adentro, pero un giro de cabecera puede atravesarlas: medido tanto con
# el planificador propio como con Fields2Cover, los enlaces Dubins entre pasadas
# no son conscientes de obstaculos. La garantia de que el vehiculo no entre
# nunca es el filtro keepout del costmap, no este campo.
interfaces/GeoRing[] coverage_exclusions

float64 cutter_width_m
float64 overlap_ratio
float64 min_turning_radius_m
float64 waypoint_spacing_m
string side
---
bool ok
string error

# Con que definicion de lote se planifico: "polygon" o "rectangle". Permite al
# cockpit detectar que mando un poligono y el backend planifico el rectangulo.
string field_mode

# Inicio efectivo del centro de la primera pasada, despues del inset opcional.
float64 route_start_lat
float64 route_start_lon
float64 route_start_yaw_deg
float64 centerline_length_m

# Polilinea completa solo para preview. No debe enviarse como metas a Nav2.
float64[] sampled_lats
float64[] sampled_lons
float64[] sampled_yaws_deg
string[] sampled_phases
int32[] sampled_row_indices
bool[] sampled_key_flags

# Extremos canonicos de cada pasada (metas key/de parada).
float64[] key_lats
float64[] key_lons
float64[] key_yaws_deg

# Ruta ejecutable: extremos key + una guia no-key en el punto exterior de cada
# cabecera. Las guias viajan en el mismo chunk y no son metas de parada.
float64[] route_lats
float64[] route_lons
float64[] route_yaws_deg
bool[] route_key_flags

uint32 row_count
float64 lane_spacing_m
int32[] row_visit_order
float64[] turn_separations_m
uint32 clean_uturn_count
uint32 omega_turn_count
float64 estimated_path_length_m
float64 headland_before_m
float64 headland_after_m
float64 lateral_overflow_m

uint32 strict_crossing_count
uint32 nonadjacent_touch_count
uint32 collinear_overlap_count
uint32 topology_conflict_count
# Subconjunto de conflictos que cae dentro del rectangulo fisico del campo.
uint32 field_strict_crossing_count
uint32 field_nonadjacent_touch_count
uint32 field_collinear_overlap_count
uint32 field_topology_conflict_count
# La regla depende de topology_scope:
#
#   global         : ningun conflicto en toda la polilinea y cero giros omega.
#   field_interior : ningun conflicto dentro del rectangulo, con giros y cruces
#                    exteriores solo informativos.
#   fields2cover   : NO hubo auditoria topologica. La auditoria de arriba mide
#                    autointersecciones del zigzag propio y no aplica a una
#                    trayectoria de Fields2Cover, que tiene otra estructura.
#                    Con este alcance topology_safe=true significa unicamente
#                    "Fields2Cover produjo la trayectoria sin errores", no
#                    "el verificador legacy la reviso y dio limpia". Los
#                    contadores de conflictos van en cero por eso mismo: son
#                    ausencia de medicion, no ausencia de conflictos.
bool topology_safe
string topology_scope
# Si se corrio de verdad la auditoria topologica. En false, topology_safe y los
# contadores de conflictos no significan nada: no se midieron. Evita tener que
# deducir "no auditado" mirando el string de topology_scope.
bool topology_audited
float64 topology_audit_spacing_m
float64 planner_min_turning_radius_m

# Efecto de las zonas no-go sobre el trazado. nogo_note viene con el motivo
# cuando no se pudieron leer las zonas: en ese caso los tres contadores van en
# cero y el trazado NO esta recortado, aunque el operador tenga zonas dibujadas.
uint32 nogo_polygon_count
uint32 nogo_dropped_count
uint32 nogo_detour_count
string nogo_note

float64 recommended_leg_spacing_m
float64 recommended_chunk_span_m
uint32 recommended_chunk_max_waypoints
